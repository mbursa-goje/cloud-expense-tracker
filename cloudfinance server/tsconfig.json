{
    "compilerOptions": {
        "target": "es2025",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "strict": true,
        "esModuleInterop": true,
        "ignoreDeprecations": "6.0",
        "types": ["node"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}